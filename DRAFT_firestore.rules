rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 3: Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMatric(m) {
      return m is string && m.size() == 9 && m.matches('^[0-9]{9}$');
    }

    function isValidSha256(h) {
      return h is string && h.size() == 64 && h.matches('^[a-f0-9]{64}$');
    }

    function isValidEmail(e) {
      return e is string && e.size() >= 5 && e.size() <= 180 && e.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isValidLevel(lvl) {
      return lvl is string && lvl in ['100', '200', '300', '400', '500'];
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Bootstrapped administrators (runtime user email + official ECSA initial admin)
    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() in [
          'progressgodson3@gmail.com',
          'psmartprogress@gmail.com'
        ];
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['president', 'election_chairman']
      );
    }

    // -------------------------------------------------------------------------
    // Phase 2: Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'role', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'fullName', 'role', 'active', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isValidEmail(data.email) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.role is string && data.role in ['president', 'election_chairman'] &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminInvite(data) {
      return data.keys().hasAll(['role', 'email', 'fullName', 'invitedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['role', 'email', 'fullName', 'invitedBy', 'createdAt', 'updatedAt']) &&
        data.role is string && data.role in ['president', 'election_chairman'] &&
        isValidEmail(data.email) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        isValidId(data.invitedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
          'uid', 'fullName', 'matric', 'email', 'level', 'department',
          'surnameHash', 'surnameSalt', 'verifiedByRoll', 'registeredAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'fullName', 'matric', 'email', 'level', 'department',
          'surnameHash', 'surnameSalt', 'verifiedByRoll', 'registeredAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 140 &&
        isValidMatric(data.matric) &&
        isValidEmail(data.email) &&
        isValidLevel(data.level) &&
        data.department is string && data.department.size() >= 2 && data.department.size() <= 120 &&
        isValidSha256(data.surnameHash) &&
        data.surnameSalt is string && data.surnameSalt.size() >= 16 && data.surnameSalt.size() <= 64 &&
        data.verifiedByRoll is bool &&
        data.registeredAt is timestamp;
    }

    function isValidMatricIndex(data) {
      return data.keys().hasAll(['matric', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['matric', 'ownerUid', 'createdAt']) &&
        isValidMatric(data.matric) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidEmailIndex(data) {
      return data.keys().hasAll(['emailHash', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['emailHash', 'ownerUid', 'createdAt']) &&
        isValidSha256(data.emailHash) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidEligibleVoter(data) {
      return data.keys().hasAll(['matric', 'expectedLevel', 'department', 'active', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['matric', 'expectedLevel', 'department', 'active', 'addedBy', 'createdAt']) &&
        isValidMatric(data.matric) &&
        isValidLevel(data.expectedLevel) &&
        data.department is string && data.department.size() >= 2 && data.department.size() <= 120 &&
        data.active is bool &&
        isValidId(data.addedBy) &&
        data.createdAt is timestamp;
    }

    function isValidRejectedAttempt(data) {
      return data.keys().hasAll(['attemptId', 'userUid', 'matric', 'attemptedLevel', 'department', 'reason', 'createdAt']) &&
        data.keys().hasOnly(['attemptId', 'userUid', 'matric', 'attemptedLevel', 'department', 'reason', 'createdAt']) &&
        isValidId(data.attemptId) &&
        isValidId(data.userUid) &&
        data.userUid == request.auth.uid &&
        data.matric is string && data.matric.size() <= 20 &&
        data.attemptedLevel is string && data.attemptedLevel.size() <= 10 &&
        data.department is string && data.department.size() <= 120 &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 240 &&
        data.createdAt is timestamp;
    }

    function isValidElection(data) {
      return data.keys().hasAll([
          'electionId', 'title', 'academicSession', 'status', 'ballotMode',
          'resultsMode', 'resultsPublished', 'requireVoterRoll', 'isActive',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'electionId', 'title', 'academicSession', 'status', 'ballotMode',
          'resultsMode', 'resultsPublished', 'requireVoterRoll', 'isActive',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.electionId) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 160 &&
        data.academicSession is string && data.academicSession.size() >= 4 && data.academicSession.size() <= 32 &&
        data.status is string && data.status in ['not_started', 'ongoing', 'completed'] &&
        data.ballotMode is string && data.ballotMode in ['per_position', 'compulsory_all'] &&
        data.resultsMode is string && data.resultsMode in ['after_publish', 'live'] &&
        data.resultsPublished is bool &&
        data.requireVoterRoll is bool &&
        data.isActive is bool &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPosition(data) {
      return data.keys().hasAll([
          'positionId', 'electionId', 'title', 'description',
          'displayOrder', 'candidateCount', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'positionId', 'electionId', 'title', 'description',
          'displayOrder', 'candidateCount', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.positionId) &&
        isValidId(data.electionId) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.description is string && data.description.size() <= 300 &&
        data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 100 &&
        data.candidateCount is int && data.candidateCount >= 0 && data.candidateCount <= 10 &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCandidate(data) {
      return data.keys().hasAll([
          'candidateId', 'electionId', 'positionId', 'positionTitle',
          'fullName', 'politicalName', 'academicLevel', 'department',
          'manifesto', 'photoUrl', 'manifestoPdfUrl', 'approvalStatus',
          'registeredBy', 'registeredByName', 'updatedBy', 'dateRegistered', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'candidateId', 'electionId', 'positionId', 'positionTitle',
          'fullName', 'politicalName', 'academicLevel', 'department',
          'manifesto', 'photoUrl', 'manifestoPdfUrl', 'approvalStatus',
          'registeredBy', 'registeredByName', 'updatedBy', 'dateRegistered', 'updatedAt'
        ]) &&
        isValidId(data.candidateId) &&
        isValidId(data.electionId) &&
        isValidId(data.positionId) &&
        data.positionTitle is string && data.positionTitle.size() >= 2 && data.positionTitle.size() <= 100 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140 &&
        data.politicalName is string && data.politicalName.size() >= 2 && data.politicalName.size() <= 80 &&
        isValidLevel(data.academicLevel) &&
        data.department is string && data.department.size() <= 120 &&
        data.manifesto is string && data.manifesto.size() <= 12000 &&
        data.photoUrl is string && data.photoUrl.size() <= 500 &&
        data.manifestoPdfUrl is string && data.manifestoPdfUrl.size() <= 500 &&
        data.approvalStatus is string && data.approvalStatus in ['approved', 'pending'] &&
        isValidId(data.registeredBy) &&
        data.registeredByName is string && data.registeredByName.size() <= 140 &&
        isValidId(data.updatedBy) &&
        data.dateRegistered is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTally(data) {
      return data.keys().hasAll([
          'candidateId', 'electionId', 'positionId',
          'votes', 'affirmVotes', 'rejectVotes', 'resultsVisible'
        ]) &&
        data.keys().hasOnly([
          'candidateId', 'electionId', 'positionId',
          'votes', 'affirmVotes', 'rejectVotes', 'resultsVisible'
        ]) &&
        isValidId(data.candidateId) &&
        isValidId(data.electionId) &&
        isValidId(data.positionId) &&
        data.votes is int && data.votes >= 0 &&
        data.affirmVotes is int && data.affirmVotes >= 0 &&
        data.rejectVotes is int && data.rejectVotes >= 0 &&
        data.resultsVisible is bool;
    }

    function isValidVoteReceipt(data) {
      return data.keys().hasAll(['receiptId', 'electionId', 'positionId', 'voterUid', 'castAt']) &&
        data.keys().hasOnly(['receiptId', 'electionId', 'positionId', 'voterUid', 'castAt']) &&
        isValidId(data.receiptId) &&
        isValidId(data.electionId) &&
        isValidId(data.positionId) &&
        isValidId(data.voterUid) &&
        data.voterUid == request.auth.uid &&
        data.castAt is timestamp;
    }

    function isValidBallot(data) {
      return data.keys().hasAll(['ballotId', 'electionId', 'positionId', 'candidateId', 'choice']) &&
        data.keys().hasOnly(['ballotId', 'electionId', 'positionId', 'candidateId', 'choice']) &&
        isValidId(data.ballotId) &&
        isValidId(data.electionId) &&
        isValidId(data.positionId) &&
        isValidId(data.candidateId) &&
        data.choice is string && data.choice in ['vote', 'affirm', 'reject'];
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['logId', 'adminUid', 'adminEmail', 'adminRole', 'action', 'targetId', 'details', 'createdAt']) &&
        data.keys().hasOnly(['logId', 'adminUid', 'adminEmail', 'adminRole', 'action', 'targetId', 'details', 'createdAt']) &&
        isValidId(data.logId) &&
        isValidId(data.adminUid) &&
        data.adminUid == request.auth.uid &&
        isValidEmail(data.adminEmail) &&
        data.adminRole is string && data.adminRole in ['president', 'election_chairman', 'super_admin'] &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.targetId is string && data.targetId.size() <= 128 &&
        data.details is string && data.details.size() <= 500 &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks (Exhaustive coverage of firebase-blueprint.json)
    // -------------------------------------------------------------------------

    // 1. Admins
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidAdmin(incoming()) &&
        incoming().uid == uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            uid == request.auth.uid &&
            incoming().active == true &&
            incoming().email.lower() == request.auth.token.email.lower() &&
            exists(/databases/$(database)/documents/adminInvites/$(incoming().role)) &&
            get(/databases/$(database)/documents/adminInvites/$(incoming().role)).data.email.lower() == request.auth.token.email.lower()
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidAdmin(incoming()) &&
        isAdmin() &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'active', 'updatedAt']);
      allow delete: if isValidId(uid) && isBootstrappedAdmin();
    }

    // 2. Admin Invites (Exactly two official role slots: president, election_chairman)
    match /adminInvites/{roleId} {
      allow get: if isVerifiedUser() &&
        roleId in ['president', 'election_chairman'] &&
        (
          isAdmin() ||
          (resource.data.email is string && resource.data.email.lower() == request.auth.token.email.lower())
        );
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        roleId in ['president', 'election_chairman'] &&
        isValidAdminInvite(incoming()) &&
        incoming().role == roleId &&
        incoming().invitedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        roleId in ['president', 'election_chairman'] &&
        isValidAdminInvite(incoming()) &&
        isAdmin() &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'fullName', 'invitedBy', 'updatedAt']);
      allow delete: if roleId in ['president', 'election_chairman'] && isAdmin();
    }

    // 3. Students (Strict PII isolation: owner or admin only)
    match /students/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(uid) &&
        isValidId(uid) &&
        isValidStudent(incoming()) &&
        incoming().uid == uid &&
        incoming().registeredAt == request.time &&
        !isAdmin() &&
        existsAfter(/databases/$(database)/documents/matricIndex/$(incoming().matric));
      allow update, delete: if false;
    }

    // 4. Matriculation Uniqueness Index
    match /matricIndex/{matric} {
      allow get: if isVerifiedUser() && isValidMatric(matric);
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidMatric(matric) &&
        isValidMatricIndex(incoming()) &&
        incoming().matric == matric &&
        incoming().createdAt == request.time &&
        !exists(/databases/$(database)/documents/matricIndex/$(matric)) &&
        existsAfter(/databases/$(database)/documents/students/$(request.auth.uid));
      allow update, delete: if false;
    }

    // 5. Email Hash Uniqueness Index
    match /emailIndex/{emailHash} {
      allow get: if isVerifiedUser() && isValidSha256(emailHash);
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidSha256(emailHash) &&
        isValidEmailIndex(incoming()) &&
        incoming().emailHash == emailHash &&
        incoming().createdAt == request.time &&
        !exists(/databases/$(database)/documents/emailIndex/$(emailHash)) &&
        existsAfter(/databases/$(database)/documents/students/$(request.auth.uid));
      allow update, delete: if false;
    }

    // 6. Eligible Voters Register (Non-PII matric/level check; admin manages list)
    match /eligibleVoters/{matric} {
      allow get: if isVerifiedUser() && isValidMatric(matric);
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidMatric(matric) &&
        isValidEligibleVoter(incoming()) &&
        incoming().matric == matric &&
        incoming().addedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidMatric(matric) &&
        isValidEligibleVoter(incoming()) &&
        isAdmin() &&
        incoming().matric == existing().matric &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['expectedLevel', 'department', 'active', 'addedBy']);
      allow delete: if isValidMatric(matric) && isAdmin();
    }

    // 7. Rejected Voter Verification Attempts
    match /rejectedAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(attemptId) &&
        isValidRejectedAttempt(incoming()) &&
        incoming().attemptId == attemptId &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 8. Elections (Public metadata readable; admin-only writes)
    match /elections/{electionId} {
      allow get: if isValidId(electionId);
      allow list: if resource.data.isActive is bool;
      allow create: if isVerifiedUser() &&
        isValidId(electionId) &&
        isValidElection(incoming()) &&
        incoming().electionId == electionId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(electionId) &&
        isValidElection(incoming()) &&
        isAdmin() &&
        incoming().electionId == existing().electionId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'academicSession', 'ballotMode', 'requireVoterRoll', 'isActive', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['resultsMode', 'resultsPublished', 'updatedAt'])
        );
      allow delete: if false;
    }

    // 9. Positions (Enforces 0 <= candidateCount <= 10 at database level)
    match /positions/{positionId} {
      allow get: if isValidId(positionId);
      allow list: if resource.data.electionId is string;
      allow create: if isVerifiedUser() &&
        isValidId(positionId) &&
        isValidPosition(incoming()) &&
        incoming().positionId == positionId &&
        incoming().candidateCount == 0 &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        exists(/databases/$(database)/documents/elections/$(incoming().electionId)) &&
        get(/databases/$(database)/documents/elections/$(incoming().electionId)).data.status == 'not_started';
      allow update: if isVerifiedUser() &&
        isValidId(positionId) &&
        isValidPosition(incoming()) &&
        isAdmin() &&
        incoming().positionId == existing().positionId &&
        incoming().electionId == existing().electionId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        get(/databases/$(database)/documents/elections/$(existing().electionId)).data.status == 'not_started' &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'displayOrder', 'updatedAt']) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['candidateCount', 'updatedAt']) &&
            (incoming().candidateCount == existing().candidateCount + 1 || incoming().candidateCount == existing().candidateCount - 1)
          )
        );
      allow delete: if isValidId(positionId) &&
        isAdmin() &&
        existing().candidateCount == 0 &&
        get(/databases/$(database)/documents/elections/$(existing().electionId)).data.status == 'not_started';
    }

    // 10. Candidates (Blocked after election starts; enforces <= 10 per position atomically)
    match /candidates/{candidateId} {
      allow get: if isValidId(candidateId) && (resource.data.approvalStatus == 'approved' || isAdmin());
      allow list: if resource.data.approvalStatus == 'approved' || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(candidateId) &&
        isValidCandidate(incoming()) &&
        incoming().candidateId == candidateId &&
        incoming().registeredBy == request.auth.uid &&
        incoming().updatedBy == request.auth.uid &&
        incoming().dateRegistered == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        exists(/databases/$(database)/documents/elections/$(incoming().electionId)) &&
        get(/databases/$(database)/documents/elections/$(incoming().electionId)).data.status == 'not_started' &&
        exists(/databases/$(database)/documents/positions/$(incoming().positionId)) &&
        get(/databases/$(database)/documents/positions/$(incoming().positionId)).data.electionId == incoming().electionId &&
        get(/databases/$(database)/documents/positions/$(incoming().positionId)).data.candidateCount < 10 &&
        getAfter(/databases/$(database)/documents/positions/$(incoming().positionId)).data.candidateCount == get(/databases/$(database)/documents/positions/$(incoming().positionId)).data.candidateCount + 1 &&
        existsAfter(/databases/$(database)/documents/tallies/$(candidateId));
      allow update: if isVerifiedUser() &&
        isValidId(candidateId) &&
        isValidCandidate(incoming()) &&
        isAdmin() &&
        incoming().candidateId == existing().candidateId &&
        incoming().electionId == existing().electionId &&
        incoming().positionId == existing().positionId &&
        incoming().registeredBy == existing().registeredBy &&
        incoming().registeredByName == existing().registeredByName &&
        incoming().dateRegistered == existing().dateRegistered &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        get(/databases/$(database)/documents/elections/$(existing().electionId)).data.status == 'not_started' &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'politicalName', 'academicLevel', 'department',
          'manifesto', 'photoUrl', 'manifestoPdfUrl', 'approvalStatus',
          'updatedBy', 'updatedAt'
        ]);
      allow delete: if isValidId(candidateId) &&
        isAdmin() &&
        get(/databases/$(database)/documents/elections/$(existing().electionId)).data.status == 'not_started' &&
        getAfter(/databases/$(database)/documents/positions/$(existing().positionId)).data.candidateCount == get(/databases/$(database)/documents/positions/$(existing().positionId)).data.candidateCount - 1;
    }

    // 11. Tallies (Zero voter PII; strict publication gating; admins cannot alter vote counts)
    match /tallies/{candidateId} {
      allow get: if isValidId(candidateId) && (resource.data.resultsVisible == true || isAdmin());
      allow list: if resource.data.resultsVisible == true || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(candidateId) &&
        isValidTally(incoming()) &&
        incoming().candidateId == candidateId &&
        incoming().votes == 0 &&
        incoming().affirmVotes == 0 &&
        incoming().rejectVotes == 0 &&
        isAdmin() &&
        existsAfter(/databases/$(database)/documents/candidates/$(candidateId));
      allow update: if isVerifiedUser() &&
        isValidId(candidateId) &&
        isValidTally(incoming()) &&
        incoming().candidateId == existing().candidateId &&
        incoming().electionId == existing().electionId &&
        incoming().positionId == existing().positionId &&
        (
          // Tier 1 (Admin): Publication visibility toggle ONLY — never modify vote counts
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['resultsVisible'])
          ) ||
          // Tier 2 (Registered Student Voter): Atomic +1 vote increment paired with new VoteReceipt
          (
            !isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['votes', 'affirmVotes', 'rejectVotes']) &&
            (
              (incoming().votes == existing().votes + 1 && incoming().affirmVotes == existing().affirmVotes + 1 && incoming().rejectVotes == existing().rejectVotes) ||
              (incoming().votes == existing().votes + 1 && incoming().rejectVotes == existing().rejectVotes + 1 && incoming().affirmVotes == existing().affirmVotes)
            ) &&
            exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/elections/$(existing().electionId)).data.status == 'ongoing' &&
            !exists(/databases/$(database)/documents/voteReceipts/$(existing().electionId + '_' + existing().positionId + '_' + request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/voteReceipts/$(existing().electionId + '_' + existing().positionId + '_' + request.auth.uid))
          )
        );
      allow delete: if isValidId(candidateId) &&
        isAdmin() &&
        existing().votes == 0 &&
        get(/databases/$(database)/documents/elections/$(existing().electionId)).data.status == 'not_started';
    }

    // 12. Vote Receipts (One per student per position; immutable; NO candidateId)
    match /voteReceipts/{receiptId} {
      allow get: if isValidId(receiptId) && isVerifiedUser() && (resource.data.voterUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.voterUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(receiptId) &&
        isValidVoteReceipt(incoming()) &&
        incoming().receiptId == receiptId &&
        receiptId == incoming().electionId + '_' + incoming().positionId + '_' + request.auth.uid &&
        incoming().castAt == request.time &&
        !isAdmin() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/elections/$(incoming().electionId)) &&
        get(/databases/$(database)/documents/elections/$(incoming().electionId)).data.status == 'ongoing' &&
        exists(/databases/$(database)/documents/positions/$(incoming().positionId)) &&
        get(/databases/$(database)/documents/positions/$(incoming().positionId)).data.electionId == incoming().electionId &&
        !exists(/databases/$(database)/documents/voteReceipts/$(receiptId));
      allow update, delete: if false;
    }

    // 13. Anonymous Ballots (Immutable; ZERO voter identity fields)
    match /ballots/{ballotId} {
      allow get: if isValidId(ballotId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(ballotId) &&
        isValidBallot(incoming()) &&
        incoming().ballotId == ballotId &&
        !isAdmin() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/elections/$(incoming().electionId)).data.status == 'ongoing' &&
        exists(/databases/$(database)/documents/candidates/$(incoming().candidateId)) &&
        get(/databases/$(database)/documents/candidates/$(incoming().candidateId)).data.electionId == incoming().electionId &&
        get(/databases/$(database)/documents/candidates/$(incoming().candidateId)).data.positionId == incoming().positionId &&
        get(/databases/$(database)/documents/candidates/$(incoming().candidateId)).data.approvalStatus == 'approved' &&
        !exists(/databases/$(database)/documents/voteReceipts/$(incoming().electionId + '_' + incoming().positionId + '_' + request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/voteReceipts/$(incoming().electionId + '_' + incoming().positionId + '_' + request.auth.uid));
      allow update, delete: if false;
    }

    // 14. Administrative Audit Logs (Immutable; Admin-only)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().logId == logId &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update, delete: if false;
    }
  }
}
